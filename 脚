RunService.RenderStepped:Connect(function()
 local cm=cam() if not cm then return end
 local cnt=0
 for p,d in pairs(espCache)do
  if not p.Parent then rmESP(p) continue end
  local c=p.Character
  local hd=c and c:FindFirstChild("Head")
  local hm=c and c:FindFirstChildOfClass("Humanoid")
  if not hd or not hm or hm.Health<=0 then d.root.Visible=false if d.highlight then d.highlight.Enabled=false end continue end
  local ds=(cm.CFrame.Position-hd.Position).Magnitude
  if ds>CFG.ESP.MaxDistance then d.root.Visible=false if d.highlight then d.highlight.Enabled=false end continue end
  local mt=CFG.ESP.TeamCheck and isMate(p)
  local hide=CFG.ESP.HideTeammate and mt
  if not CFG.ESP.Enabled or hide then d.root.Visible=false
  else
   local en=not mt
   local col=en and Color3.fromRGB(255,120,180)or Color3.fromRGB(120,220,130)
   d.billboard.Adornee=hd d.billboard.MaxDistance=CFG.ESP.MaxDistance d.root.Visible=true cnt=cnt+1
   d.nameLbl.Visible=CFG.ESP.ShowName d.nameLbl.TextColor3=col
   d.hpFill.Visible=CFG.ESP.ShowHealth
   local hp=math.clamp(hm.Health/hm.MaxHealth,0,1)
   d.hpFill.Size=UDim2.new(hp,0,1,0)
