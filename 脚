local noclipBackup={} local noclipApplied=false
local function applyNoClip()
 local c=LP.Character if not c then return end
 noclipBackup={}
 for _,part in ipairs(c:GetDescendants())do
  if part:IsA("BasePart")then noclipBackup[part]=part.CanCollide pcall(function()part.CanCollide=false end) end
 end
 noclipApplied=true
end
local function removeNoClip()
 for part,orig in pairs(noclipBackup)do if part and part.Parent then pcall(function()part.CanCollide=orig end) end end
 noclipBackup={} noclipApplied=false
end
LP.CharacterAdded:Connect(function() noclipBackup={} noclipApplied=false end)

local flyBV=nil local flyBG=nil local flyActive=false
local function startFly()
 local c=LP.Character if not c then return end
 local hrp=c:FindFirstChild("HumanoidRootPart")
 local hum=c:FindFirstChildOfClass("Humanoid")
 if not hrp or not hum then return end
 flyActive=true hum.PlatformStand=true
 if not flyBV or not flyBV.Parent then
  flyBV=Instance.new("BodyVelocity")flyBV.MaxForce=Vector3.new(1e5,1e5,1e5)flyBV.Velocity=Vector3.new(0,0,0)flyBV.Parent=hrp
 end
 if not flyBG or not flyBG.Parent then
  flyBG=Instance.new("BodyGyro")flyBG.MaxTorque=Vector3.new(1e5,1e5,1e5)flyBG.P=10000 flyBG.D=500 flyBG.CFrame=hrp.CFrame flyBG.Parent=hrp
 end
end
local function stopFly()
 flyActive=false flyDirUp=false flyDirDown=false flyDirLeft=false flyDirRight=false
 local c=LP.Character
 if c then local hum=c:FindFirstChildOfClass("Humanoid") if hum then hum.PlatformStand=false end end
 if flyBV then flyBV:Destroy()flyBV=nil end
 if flyBG then flyBG:Destroy()flyBG=nil end
 removeNoClip()
end
task.spawn(function()
 while true do
  RunService.RenderStepped:Wait()
  if not CFG.Movement.FlyEnabled then
   if flyActive then stopFly()end
   if Pad.Visible then Pad.Visible=false end
   continue
  end
  if not Pad.Visible then Pad.Visible=true end
  local c=LP.Character if not c then if flyActive then stopFly()end continue end
  local hrp=c:FindFirstChild("HumanoidRootPart")
  local hum=c:FindFirstChildOfClass("Humanoid")
  if not hrp or not hum then if flyActive then stopFly()end continue end
  if not flyActive then startFly()end
  if not flyBV or not flyBV.Parent then startFly()end
  if CFG.Movement.FlyNoClip then
   if not noclipApplied then applyNoClip() else
    for _,part in ipairs(c:GetDescendants())do if part:IsA("BasePart")and part.CanCollide then pcall(function()part.CanCollide=false end) end end
   end
  else
   if noclipApplied then removeNoClip()end
  end
  local cm=cam() if not cm then continue end
  local camF=cm.CFrame.LookVector
  local camR=cm.CFrame.RightVector
  local camRH=Vector3.new(camR.X,0,camR.Z)
  if camRH.Magnitude>0.001 then camRH=camRH.Unit else camRH=Vector3.new(1,0,0) end
  local moveDir=hum.MoveDirection
  local moveVel=Vector3.new(0,0,0)
  if moveDir.Magnitude>0.01 then moveVel=moveDir*CFG.Movement.Speed end
  local flyVel=Vector3.new(0,0,0)
  if flyDirUp then flyVel=flyVel+Vector3.new(0,CFG.Movement.FlySpeed,0) end
  if flyDirDown then flyVel=flyVel-Vector3.new(0,CFG.Movement.FlySpeed,0) end
  if flyDirLeft then flyVel=flyVel-camRH*CFG.Movement.FlySpeed end
  if flyDirRight then flyVel=flyVel+camRH*CFG.Movement.FlySpeed end
  if UIS:IsKeyDown(Enum.KeyCode.Space) then flyVel=flyVel+Vector3.new(0,CFG.Movement.FlySpeed,0) end
  if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then flyVel=flyVel-Vector3.new(0,CFG.Movement.FlySpeed,0) end
  local finalVel=moveVel+flyVel
  if finalVel.Magnitude<0.01 then finalVel=Vector3.new(0,0,0) end
  if flyBV and flyBV.Parent then flyBV.Velocity=finalVel end
  if flyBG and flyBG.Parent then flyBG.CFrame=CFrame.new(hrp.Position,hrp.Position+camF) end
 end
end)

