local function doMarkTeleport(sx,sy)
 local cm=cam() if not cm then return end
 local myChar=LP.Character if not myChar then return end
 local myRoot=myChar:FindFirstChild("HumanoidRootPart") if not myRoot then return end
 local ray=cm:ViewportPointToRay(sx,sy)
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={myChar}
 params.IgnoreWater=true
 local result=WS:Raycast(ray.Origin,ray.Direction*5000,params)
 local pos = result and result.Position or (ray.Origin+ray.Direction*500)
 myRoot.CFrame=CFrame.new(pos+Vector3.new(0,3,0))
 if CFG.MarkTP.ShowMarker then
  local sp,onScreen=cm:WorldToViewportPoint(pos)
  if onScreen then
   Marker.Position=UDim2.new(0,sp.X,0,sp.Y)Marker.Visible=true
   task.delay(1.2,function()if Marker then Marker.Visible=false end end)
  end
 end
 notify("标点传送","已传送到点击位置")
end

