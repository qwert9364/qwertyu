local disguiseState={ClientMode=false,FakeBody=nil,NameGui=nil,SyncThread=nil,BackupParts=nil}
local function cleanupClientDisguise()
 if disguiseState.FakeBody then pcall(function()disguiseState.FakeBody:Destroy()end) disguiseState.FakeBody=nil end
 if disguiseState.NameGui then pcall(function()disguiseState.NameGui:Destroy()end) disguiseState.NameGui=nil end
 if disguiseState.BackupParts then
  for part,data in pairs(disguiseState.BackupParts)do
   if part and part.Parent then
    pcall(function()
     if data.MeshId and part:IsA("MeshPart")then part.MeshId=data.MeshId end
     if data.TextureID and part:IsA("MeshPart")then part.TextureID=data.TextureID end
     if data.Color then part.Color=data.Color end
     if data.Material then part.Material=data.Material end
    end)
   end
  end
  disguiseState.BackupParts=nil
 end
 local myChar=LP.Character
 if myChar then for _,part in ipairs(myChar:GetDescendants())do if part:IsA("BasePart")then pcall(function()part.LocalTransparencyModifier=0 end) end end end
 disguiseState.ClientMode=false
end

local function tryCloneDisguise(target)
 local myChar=LP.Character local tgtChar=target.Character
 if not myChar or not tgtChar then return false,"角色未加载" end
 for _,part in ipairs(myChar:GetDescendants())do if part:IsA("BasePart")then pcall(function()part.LocalTransparencyModifier=1 end) end end
 local ok,result=pcall(function()
  local fake=tgtChar:Clone()
  if not fake then error("Clone 返回空")end
  fake.Name="_Fk"..math.random(100000,999999)
  local toRemove={}
  for _,obj in ipairs(fake:GetDescendants())do
   if obj:IsA("Script")or obj:IsA("LocalScript")or obj:IsA("ModuleScript")or obj:IsA("Humanoid")then table.insert(toRemove,obj)
   elseif obj:IsA("BasePart")then pcall(function()obj.CanCollide=false obj.CanQuery=false obj.CanTouch=false obj.Massless=true obj.Anchored=false obj.Locked=true end) end
  end
  for _,obj in ipairs(toRemove)do pcall(function()obj:Destroy()end) end
  fake.Parent=WS disguiseState.FakeBody=fake disguiseState.ClientMode=true
  disguiseState.SyncThread=task.spawn(function()
   while disguiseState.FakeBody and disguiseState.FakeBody.Parent do
    RunService.RenderStepped:Wait()
    local c=LP.Character
    if c and disguiseState.FakeBody then pcall(function()disguiseState.FakeBody:PivotTo(c:GetPivot())end) end
   end
  end)
 end)
 if not ok then
  for _,part in ipairs(myChar:GetDescendants())do if part:IsA("BasePart")then pcall(function()part.LocalTransparencyModifier=0 end) end end
  return false,tostring(result)
 end
 return true
end

local function doDisguise(target)
 if not target then notify("伪装失败","未选择玩家") return false end
 local myChar=LP.Character local tgtChar=target.Character
 if not myChar then notify("伪装失败","你的角色未加载") return false end
 if not tgtChar then notify("伪装失败","目标角色未加载") return false end
 local myHum=myChar:FindFirstChildOfClass("Humanoid") local tgtHum=tgtChar:FindFirstChildOfClass("Humanoid")
 if not myHum or not tgtHum then notify("伪装失败","找不到 Humanoid") return false end
 if not CFG.Disguise.OriginalDescription then
  local ok,desc=pcall(function()return myHum:GetAppliedDescription()end)
  if ok and desc then CFG.Disguise.OriginalDescription=desc end
 end
 local applied=false
 local ok,desc2=pcall(function()return tgtHum:GetAppliedDescription()end)
 if ok and desc2 then applied=pcall(function()myHum:ApplyDescription(desc2)end) end
 local fakeName=target.DisplayName if not fakeName or fakeName=="" then fakeName=target.Name end
 pcall(function()myHum.DisplayName=fakeName end)
 if applied then
  notify("伪装成功","已伪装成 "..target.Name.."（服务器）")
  CFG.Disguise.Disguised=true CFG.Disguise.TargetPlayer=target return true
 end
 local okB,errB=tryCloneDisguise(target)
 if okB then
  notify("伪装成功","已伪装成 "..target.Name.."（克隆）")
  CFG.Disguise.Disguised=true CFG.Disguise.TargetPlayer=target return true
 end
 notify("伪装失败",tostring(errB)) return false
end

local function doUndisguise()
 cleanupClientDisguise()
 local myChar=LP.Character
 if myChar then
  local myHum=myChar:FindFirstChildOfClass("Humanoid")
  if myHum then
   if CFG.Disguise.OriginalDescription then pcall(function()myHum:ApplyDescription(CFG.Disguise.OriginalDescription)end) end
   pcall(function()myHum.DisplayName=LP.DisplayName end)
  end
 end
 CFG.Disguise.Disguised=false CFG.Disguise.TargetPlayer=nil CFG.Disguise.OriginalDescription=nil
 notify("已取消伪装","恢复原始外观")
end
