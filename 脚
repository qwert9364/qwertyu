local function isMate(p)
 if p==LP then return true end
 if LP.Team~=nil and p.Team~=nil and LP.Team==p.Team then return true end
 if LP.TeamColor~=nil and p.TeamColor~=nil and LP.TeamColor==p.TeamColor then return true end
 for _,a in ipairs({"Team","team","TeamId","teamId","TEAM"})do
  local x=LP:GetAttribute(a)local y=p:GetAttribute(a)
  if x~=nil and y~=nil and x==y then return true end
 end
 local c1=LP.Character local c2=p.Character
 if c1 and c2 then
  for _,a in ipairs({"Team","team","TeamId","teamId"})do
   local x=c1:GetAttribute(a)local y=c2:GetAttribute(a)
   if x~=nil and y~=nil and x==y then return true end
  end
 end
 return false
end

local function los(tp)
 local c=LP.Character if not c then return false end
 local r=c:FindFirstChild("HumanoidRootPart")or c:FindFirstChild("Head")or c:FindFirstChildWhichIsA("BasePart")
 if not r then return false end
 local tc=tp:FindFirstAncestorOfClass("Model")
 local o=r.Position local d=tp.Position-o
 if d.Magnitude<0.1 then return true end
 local p=RaycastParams.new()p.FilterType=Enum.RaycastFilterType.Exclude
 local f={c}if tc then table.insert(f,tc)end
 p.FilterDescendantsInstances=f p.IgnoreWater=true
 return WS:Raycast(o,d,p)==nil
end

local function holding()
 local c=LP.Character if not c then return false end
 if c:FindFirstChildOfClass("Tool")then return true end
 local h=c:FindFirstChild("RightHand")or c:FindFirstChild("Right Arm")or c:FindFirstChild("LeftHand")
 if h then for _,x in ipairs(h:GetChildren())do if x:IsA("BasePart")or x:IsA("MeshPart")or x:IsA("Model")then return true end end end
 return false
end

