-- ============ 自瞄 ============
local lTD=0
local function getT()
 local cm=cam() if not cm then return nil end
 local ct=Vector2.new(cm.ViewportSize.X/2,cm.ViewportSize.Y/2)
 local b,bs=nil,math.huge
 for _,p in ipairs(Players:GetPlayers())do
  if p==LP then continue end
  local c=p.Character if not c then continue end
  local h=c:FindFirstChildOfClass("Humanoid") if not h or h.Health<=0 then continue end
  if CFG.Aimbot.HideTeammate and isMate(p)then continue end
  if CFG.Aimbot.TeamCheck and isMate(p)then continue end
  local pr=c:FindFirstChild("Head")or c:FindFirstChild("HumanoidRootPart") if not pr then continue end
  local ds=(pr.Position-cm.CFrame.Position).Magnitude
  if ds>CFG.Aimbot.Range then continue end
  local sp,os=cm:WorldToViewportPoint(pr.Position) if not os then continue end
  local sd=(Vector2.new(sp.X,sp.Y)-ct).Magnitude
  if sd>CFG.Aimbot.FOV then continue end
  if CFG.Aimbot.WallCheck and not los(pr)then continue end
  local sc=CFG.Aimbot.NearestPriority and ds or sd
  if sc<bs then bs=sc b=pr lTD=ds end
 end
 return b
end
local function updAim()
 if not CFG.Aimbot.Enabled or not holding()then ADL.Text="" return end
 local t=getT() if not t then ADL.Text="" return end
 local cm=cam() if not cm then return end
 local cur=cm.CFrame
 local dl=t.Position-cur.Position
 if dl.Magnitude<0.1 then return end
 local gl=CFrame.lookAt(cur.Position,t.Position,Vector3.new(0,1,0))
 local al=math.clamp(CFG.Aimbot.Smoothness/10,0.08,1)
 cm.CFrame=cur:Lerp(gl,al)
 if CFG.Aimbot.ShowTargetDist then ADL.Text=string.format("目标: %d studs",math.floor(lTD)) end
end
pcall(function()RunService:UnbindFromRenderStep("CSGO_Aim_v71")end)
RunService:BindToRenderStep("CSGO_Aim_v71",Enum.RenderPriority.Camera.Value+1,updAim)

